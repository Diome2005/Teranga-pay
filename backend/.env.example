# --- Serveur ---
PORT=5000
# URL publique du backend (tunnel ngrok pour les webhooks)
PUBLIC_URL=http://localhost:5000

# --- API Bitnob (Sandbox) ---
BITNOB_BASE_URL=https://api.bitnob.com
BITNOB_CLIENT_ID=
BITNOB_CLIENT_SECRET=
# Secret de vérification des webhooks Bitnob (HMAC-SHA512 du corps brut).
# Plusieurs secrets possibles, séparés par des virgules (un par webhook du dashboard).
BITNOB_WEBHOOK_SECRET=
# Debug webhook : true = journalise quelle combinaison secret × algorithme matche la
# signature reçue (SHA512 vs SHA256, WEBHOOK_SECRET vs CLIENT_SECRET). À désactiver ensuite.
WEBHOOK_DEBUG=false

# --- Étape 5 : liquidation Mobile Money (payouts) ---
# URL publique (ngrok) recevant le cycle de vie des payouts
# (payouts.* — ex. initialized / processing / success / failed)
PAYOUT_CALLBACK_URL=
# Raison du payout envoyée à l'initialize (voir Get Country Requirements)
PAYOUT_PAYMENT_REASON=goods_and_services

# --- Factures (liens de paiement) ---
# Taux BTC -> XOF utilisé pour déduire les sats quand le frontend n'envoie que le montant XOF.
# À aligner sur le taux effectif Bitnob (quote de payout) : sinon chaque paiement encaisse
# moins de sats que le payout n'en dépense et le solde s'épuise. Constaté le 2026-10-18 en
# sandbox (~48 500 000 XOF/BTC) : une facture de 1000 FCFA coûtait 2061 sats à liquider,
# alors qu'elle n'en encaissait que 1667 avec l'ancien taux 60 000 000.
XOF_PER_BTC=48500000
# Origine du frontend (génération du checkout_url partageable)
FRONTEND_URL=http://localhost:5173

# --- Étape 6 : persistance ---
# Dossier des registres JSON (factures / OTP / sessions). Défaut : backend/data
DATA_DIR=

# --- Optionnel : relais Bitnob (contournement IP whitelisting en hébergement) ---
# Voir DEPLOY.md § « IP whitelisting Bitnob » — scripts/bitnob-relay.js.
# Chaîne aléatoire OBLIGATOIRE (16+ caractères) : préfixe secret du tunnel ngrok.
RELAY_SECRET=

# --- Étape 6 : auth passwordless (OTP) ---
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
SESSION_TTL_SECONDS=2592000

# --- Étape 6 : envoi des codes OTP (SMS / WhatsApp) — optionnel ---
# Sans prestataire configuré, le code est journalisé côté serveur (dev uniquement).
# Twilio (SMS) : les 3 variables activent l'envoi SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# WhatsApp Cloud API : alternative (utilisée si Twilio est absent).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
