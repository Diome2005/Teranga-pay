# [FICHIER] : backend/.env.example — modèle des variables d'environnement
# [RÔLE] : configurer le serveur, la connexion Bitnob Sandbox et le payout Mobile Money.
# [À FAIRE PAR L'ÉQUIPE] : copier ce fichier vers .env puis renseigner les valeurs.

# Serveur
PORT=5000
FRONTEND_URL=http://localhost:5173

# API Bitnob (Sandbox) — Client ID + Client Secret
BITNOB_BASE_URL=https://api.bitnob.com
BITNOB_CLIENT_ID=
BITNOB_CLIENT_SECRET=

# Payout Mobile Money
PAYOUT_COUNTRY=SN
PAYOUT_CURRENCY=XOF
SATS_PER_XOF=16.5

# Mode démo (repli simulé si Bitnob non configuré)
DEMO_MODE=true
