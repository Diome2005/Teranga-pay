# [FICHIER] : frontend/.env.example — modèle des variables d'environnement Vite
# [RÔLE] : indiquer l'URL de l'API backend (Vite n'expose que les variables préfixées VITE_).
# [À FAIRE PAR L'ÉQUIPE] : copier vers .env et renseigner l'URL du backend (ou laisser vide pour utiliser le proxy /api).

VITE_API_URL=
